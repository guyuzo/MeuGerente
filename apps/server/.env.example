# Copie este arquivo para .env (nunca commitar o .env de verdade — já está no .gitignore).

# Connection string do Supabase (Settings > Database > Connection string > URI).
# Use a porta do pooler (6543) em produção; a porta direta (5432) funciona local/migrations.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Chave da Gemini API (aistudio.google.com/apikey). Sem ela, /api/ia/* responde 503 de propósito.
GEMINI_API_KEY=

# Confira o identificador atual na documentação do Google antes de produção (PRD seção 9.2).
GEMINI_MODEL_RAPIDO=gemini-2.5-flash

PORT=3001
WEB_ORIGIN=http://localhost:5173

# Segredo que assina o cookie de login (mínimo 32 caracteres, aleatório). Trocar derruba todas as sessões.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# "Esqueci a senha" (resend.com). Sem as duas, a rota responde 503 explícito.
# EMAIL_REMETENTE precisa ser de um domínio verificado no Resend, ex.: MEU GERENTE <nao-responda@seudominio.com.br>
RESEND_API_KEY=
EMAIL_REMETENTE=

# Endereço público do app, usado nos links do e-mail (obrigatório em produção). Ex.: https://meugerente.vercel.app
APP_URL=

# Gerações de IA por usuário a cada 24h (padrão 50) — a chave da Gemini é uma só pra todo mundo.
IA_LIMITE_DIARIO=50
