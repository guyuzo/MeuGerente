PORT=3001
FRONTEND_URL=http://localhost:5173

# TikTok for Developers (developers.tiktok.com) — login/OAuth basico.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/auth/tiktok/callback

# Dados de TikTok Shop (GMV, pedidos) normalmente exigem cadastro separado
# na TikTok Shop Partner Center (partner.tiktokshop.com), com App Key/Secret
# proprios — confirme com a TikTok qual API o seu acesso cobre antes de
# preencher isso (ver prd.md secao 6.4, risco tecnico documentado).

# Gemini (Google AI Studio: aistudio.google.com/apikey) — usado pela
# Modelagem de Video (prd.md secao 6.5). Sem essa chave o modulo continua
# navegavel, mas o botao de analisar responde explicando o que falta.
GEMINI_API_KEY=
# Trocavel sem mexer no codigo: se o nome do modelo mudar ou sua conta nao
# tiver acesso a este, ajuste aqui. Para ver o que sua chave acessa:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models" \
#     -H "x-goog-api-key: SUA_CHAVE"
GEMINI_MODELO=gemini-3.5-flash
